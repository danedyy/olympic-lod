# w3id.org/olympic-lod — permanent identifiers for the Olympic LOD project
# Maintainers: Daniel Samuel Edim, Ahmad Imran (GitHub: danedyy)
# Hosting: GitHub Pages of https://github.com/danedyy/olympic-lod

Options +FollowSymLinks
RewriteEngine on

# Ontology (oly: terms are hash IRIs: https://w3id.org/olympic-lod/ontology#MedalAward)
RewriteRule ^ontology/1\.0\.0$ https://raw.githubusercontent.com/danedyy/olympic-lod/v1.0.0/ontology/oly.ttl [R=302,L]
RewriteRule ^ontology$ https://danedyy.github.io/olympic-lod/ontology/oly.ttl [R=303,L]

# The application profile as SHACL shapes (olysh: …/shapes#)
RewriteRule ^shapes$ https://danedyy.github.io/olympic-lod/shacl/olympic-lod-shapes.ttl [R=303,L]

# Code lists, instance data and the dataset record are all in the published graph
RewriteRule ^scheme(/.*)?$ https://danedyy.github.io/olympic-lod/data/rdf/tokyo2020.ttl [R=303,L]
RewriteRule ^tokyo2020(/.*)?$ https://danedyy.github.io/olympic-lod/data/rdf/tokyo2020.ttl [R=303,L]

# Anything else: the project page
RewriteRule ^.*$ https://github.com/danedyy/olympic-lod [R=302,L]
